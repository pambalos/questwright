# Server-side key for AI extraction (Tier 2). Without it the app still runs; only system boxes are tracked.
ANTHROPIC_API_KEY=
# Optional. When set, the extraction route requires this code, so a public deployment cannot spend your key.
QW_ACCESS_CODE=
# Optional overrides.
QW_MODEL=claude-opus-5-5
QW_EFFORT=low
# Optional. Keys for the image services that paint codex illustrations (pick one in Settings).
GEMINI_API_KEY=
OPENAI_API_KEY=
BFL_API_KEY=
# Optional model overrides per service and quality, e.g. QW_IMAGE_MODEL_GEMINI_FINAL=gemini-3-pro-image
